---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---
<BaseLayout title="">
  <div class="wrap">
    <div class="hero">
      <span class="badge">元サポート校運営者が書く</span>
      <h1>まっすぐな道じゃなくても、<br />自分に合う学び方は見つかる。</h1>
      <p>
        「ナナメの学び路」は、通信制高校・サポート校・オルタナティブ教育の選び方を、
        現場で子どもたちと向き合ってきた経験から発信するブログです。
      </p>
    </div>

    <h2 class="section-title">新着記事</h2>
    <div class="post-grid">
      {posts.map((post) => {
        const dateStr = new Intl.DateTimeFormat('ja-JP', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        }).format(post.data.pubDate);
        return (
          <div class="post-card">
            <p class="cat">{post.data.category}</p>
            <h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <p class="date">{dateStr}</p>
          </div>
        );
      })}
    </div>

    <p style="text-align:center; margin: 32px 0 60px;">
      <a href="/blog/">記事をもっと見る &rarr;</a>
    </p>
  </div>
</BaseLayout>
